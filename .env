# Copia este archivo como ".env" en la raiz del proyecto y llena los valores.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).

# Cadena de conexion de MongoDB Atlas (Connect > Drivers > Java)
MONGODB_URI=mongodb+srv://almora_app:dhBD1QgOFzoutMsQ@cluster0.vxspcew.mongodb.net/
MONGODB_DATABASE=almora_db

# Secreto para firmar los JWT: 32 bytes aleatorios en Base64.
# Generalo con:  openssl rand -base64 32
# o en PowerShell: [Convert]::ToBase64String([byte[]](1..32 | % {Get-Random -Max 256}))
JWT_SECRET=45T4q3AynhzVpdVhGipxCzwsC+hjp7mYv+oPpjjN/co=

# En localhost (http) dejalo en false; en produccion con https, true
COOKIE_SECURE=false

# Superadministrador que se crea solo la primera vez que arranca la app
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=Almora2026Seguro
SUPERADMIN_NAME=Super Administrador

# Origenes que pueden llamar a la API desde el navegador (separados por coma)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:5500

# Catalogo de productos de ejemplo
DATOS_DEMO=true

# Correo (opcional). Con Gmail usa una "contrasena de aplicacion".
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@almora.org

# Respaldos automaticos (RNF-BD01): carpeta, frecuencia y cuantos conservar
BACKUP_ENABLED=true
BACKUP_DIR=respaldos
BACKUP_CRON=0 0 2 * * SUN
BACKUP_KEEP=8

# Swagger UI (documentacion interactiva). En produccion puedes ponerlo en false.
API_DOCS_ENABLED=true
